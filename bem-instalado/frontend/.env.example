REACT_APP_API_URL=
REACT_APP_API_TIMEOUT_MS=20000
# Chave pública VAPID. Esta é pública; a chave privada fica somente no backend/Vercel.
REACT_APP_WEB_PUSH_VAPID_PUBLIC_KEY=
# DSN público do projeto web no Sentry. O DSN do backend fica somente em backend/.env/Vercel.
REACT_APP_SENTRY_DSN=
# Chave pública do widget Cloudflare Turnstile. A chave secreta fica somente no backend/Vercel.
REACT_APP_TURNSTILE_SITE_KEY=
